# Copy to .env.local for development. Never commit real values.

# Postgres. Dev: docker compose (port 54329). Prod: Neon *pooled* connection string.
DATABASE_URL=postgres://litts:litts_dev_password@localhost:54329/litts_loans

# Public base URL of the app (used for auth callbacks and origin checks).
BETTER_AUTH_URL=http://localhost:3000

# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Separate 32+ byte key used to HMAC-chain the audit log. Rotate only with a chain checkpoint.
AUDIT_HMAC_KEY=
